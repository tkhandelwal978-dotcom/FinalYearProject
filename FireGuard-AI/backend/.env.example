# Copy to backend/.env and adjust. Every setting uses the FIREGUARD_ prefix.
FIREGUARD_ENVIRONMENT=development
FIREGUARD_LOG_LEVEL=INFO

# SQLite by default; e.g. postgresql+psycopg://user:pass@localhost:5432/fireguard for PostgreSQL.
# FIREGUARD_DATABASE_URL=sqlite:///./storage/fireguard.db

# Where uploaded images, thumbnails and Grad-CAM renders are stored.
# FIREGUARD_STORAGE_DIR=./storage

# Trained model checkpoint and artifacts (defaults to <project>/artifacts).
# FIREGUARD_MODEL_PATH=../artifacts/model/fireguard_efficientnet_b0.pt
# FIREGUARD_ARTIFACTS_DIR=../artifacts

# Force a device ("cpu" or "cuda"); auto-detected when unset.
# FIREGUARD_DEVICE=cpu

FIREGUARD_MAX_UPLOAD_MB=10
FIREGUARD_ENABLE_GRADCAM=true
FIREGUARD_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
